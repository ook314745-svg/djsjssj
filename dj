local function ActivateSpoof()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    CurrentIndex = CurrentIndex + 1
    if CurrentIndex > #SpeedPool then CurrentIndex = 1 end

    RealSpeed   = hum.WalkSpeed
    SpoofActive = true


    if instLbl then instLbl.Text = "SPEED: " .. tostring(SpeedPool[CurrentIndex]) end

    task.delay(0.9, function()
        SpoofActive = false
        if hum and hum.Parent then hum.WalkSpeed = RealSpeed end
        if instLbl then instLbl.Text = "INSTA RESET" end
    end)
end


