}

local function clampMainFrame()
    if not main or not main.Parent then return end
    local scale = uiScale.Scale
    local vp    = Camera.ViewportSize
    local fw    = main.Size.X.Offset * scale
    local fh    = main.Size.Y.Offset * scale
    local cx    = main.Position.X.Offset
    local cy    = main.Position.Y.Offset
    local margin = 10
    cx = math.clamp(cx, fw/2 - margin,  vp.X - fw/2 + margin)
    cy = math.clamp(cy, fh/2 - margin,  vp.Y - fh/2 + margin)
    main.Position = UDim2.new(0, cx, 0, cy)
end

