local CurrentIndex     = 0
local SpoofActive      = false
local RealSpeed        = nil
local OriginalIndex    = nil
local OriginalNewIndex = nil

local function InstallHooks()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)

    OriginalIndex = hookfunction(mt.__index, function(self, key)
        if SpoofActive and typeof(self) == "Instance"
            and self:IsA("Humanoid") and key == "WalkSpeed" then
            return SpeedPool[CurrentIndex] or 16
        end
        return OriginalIndex(self, key)
    end)

    OriginalNewIndex = hookfunction(mt.__newindex, function(self, key, value)
        if SpoofActive and typeof(self) == "Instance"
            and self:IsA("Humanoid") and key == "WalkSpeed" then
            RealSpeed = value
            return OriginalNewIndex(self, key, SpeedPool[CurrentIndex] or 16)
        end
        return OriginalNewIndex(self, key, value)
    end)

    setreadonly(mt, true)
end

pcall(InstallHooks)


