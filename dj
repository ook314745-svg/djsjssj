local PATH_BASE_STOP       = 1.35
local PATH_MIN_STOP        = 0.65
local PATH_NEXT_POINT_BIAS = 0.45
local PATH_SMOOTH_FACTOR   = 0.12
local lastFlatVel          = Vector3.zero

local function pathMoveToPoint(hrp, current, nextPoint, isSteal)
        local char = hrp.Parent
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local conn
        conn = RunService.Heartbeat:Connect(function()
                if not State.pathActive then
                        conn:Disconnect()
                        if hum then hum:Move(Vector3.zero, false) end
                        return
                end
                if hum and hum:GetState() == Enum.HumanoidStateType.Physics then return end
                local speed   = isSteal and SpeedBooster.StealSpeed or SpeedBooster.NormalSpeed
                local pos     = hrp.Position
                local target  = Vector3.new(current.X, pos.Y, current.Z)
                local dir     = target - pos
                local dist    = dir.Magnitude
                local stopDist = math.clamp(PATH_BASE_STOP - dist*0.04, PATH_MIN_STOP, PATH_BASE_STOP)
                if dist <= stopDist then
                        conn:Disconnect()
                        if hum then hum:Move(Vector3.zero, false) end
                        return
                end
                local moveDir = dir.Unit
                if nextPoint then
                        local nextDir = (Vector3.new(nextPoint.X, pos.Y, nextPoint.Z) - pos).Unit
                        moveDir = (moveDir + nextDir * PATH_NEXT_POINT_BIAS).Unit
                end
                if lastFlatVel.Magnitude > 0.1 then
                        moveDir = (moveDir*(1-PATH_SMOOTH_FACTOR) + lastFlatVel.Unit*PATH_SMOOTH_FACTOR).Unit
                end
                if hum then hum:Move(moveDir, false) end
                local vel = Vector3.new(moveDir.X*speed, hrp.Velocity.Y, moveDir.Z*speed)
                hrp.Velocity = vel
                lastFlatVel  = Vector3.new(vel.X, 0, vel.Z)
        end)
        while State.pathActive and
                (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) -
                 Vector3.new(current.X, 0, current.Z)).Magnitude > PATH_BASE_STOP
        do RunService.Heartbeat:Wait() end
end

