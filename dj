-- LETS GOOOO
local folder = "FO_Sounds"
local fileName = "sound.mp3"
local soundPath = folder .. "/" .. fileName

local assetFunc = getsynasset or getcustomasset

if not assetFunc then
    warn("Executor does not support custom assets.")
    return
end


local success, err = pcall(function()

    if not isfolder(folder) then
        makefolder(folder)
    end

    if not isfile(soundPath) then
        writefile(
            soundPath,
            game:HttpGet("https://files.catbox.moe/t3njoe")
        )
    end

    local sound = Instance.new("Sound")
    sound.SoundId = assetFunc(soundPath)
    sound.Volume = 5
    sound.Parent = game:GetService("SoundService")

    sound:Play()

    task.wait(3)

    sound:Stop()
    sound:Destroy()
end)

if not success then
    warn("Sound system disabled: ".. tostring(err))
end
