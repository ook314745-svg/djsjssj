}
local currentMode = "normal"

local CONFIG_PATH = "SpeedBooster_config.json"

local function saveConfig()
    if not writefile then return end
    local data = {
        currentMode = currentMode,
        slots = {
            normal = { NormalSpeed = modeSlots.normal.NormalSpeed, StealSpeed = modeSlots.normal.StealSpeed },
            desync = { NormalSpeed = modeSlots.desync.NormalSpeed, StealSpeed = modeSlots.desync.StealSpeed },
            lagger = { NormalSpeed = modeSlots.lagger.NormalSpeed, StealSpeed = modeSlots.lagger.StealSpeed },
        }
    }
    pcall(writefile, CONFIG_PATH, HttpService:JSONEncode(data))
end

local function loadConfig()
    if not readfile or not isfile or not isfile(CONFIG_PATH) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_PATH))
    end)
    if not ok or typeof(data) ~= "table" then return end
    if typeof(data.slots) == "table" then
        for _, m in ipairs({"normal","desync","lagger"}) do
            local s = data.slots[m]
            if typeof(s) == "table" then
                if tonumber(s.NormalSpeed) then modeSlots[m].NormalSpeed = tonumber(s.NormalSpeed) end
                if tonumber(s.StealSpeed)  then modeSlots[m].StealSpeed  = tonumber(s.StealSpeed)  end
            end
        end
    end
    if typeof(data.currentMode) == "string" and modeSlots[data.currentMode] then
        currentMode = data.currentMode
    end
    SpeedBooster.NormalSpeed = modeSlots[currentMode].NormalSpeed
    SpeedBooster.StealSpeed  = modeSlots[currentMode].StealSpeed
    SpeedBooster.Mode        = string.upper(currentMode)
end

loadConfig()

local function startSpeedBooster()
    if SpeedBooster.HeartbeatConn then SpeedBooster.HeartbeatConn:Disconnect() end

    SpeedBooster.HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not SpeedBooster.Enabled then return end
        local c = player.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not r then return end

        local carry = false
        local a = h:FindFirstChildOfClass("Animator")
        if a then
            for _, t in pairs(a:GetPlayingAnimationTracks()) do
                if string.find(t.Animation.AnimationId, "71186871415348") then carry = true break end
            end
        end

        local moving = h.MoveDirection.Magnitude > 0.05

        if moving then
            local vel = carry and SpeedBooster.StealSpeed or SpeedBooster.NormalSpeed
            r.Velocity = Vector3.new(
                h.MoveDirection.X * vel,
                r.Velocity.Y,
                h.MoveDirection.Z * vel
            )
        end
        

        
    end)
end

local function stopSpeedBooster()
    if SpeedBooster.HeartbeatConn then
        SpeedBooster.HeartbeatConn:Disconnect()
        SpeedBooster.HeartbeatConn = nil
    end
end


local function applyMode(modeName)
    local slot = modeSlots[modeName]
    SpeedBooster.NormalSpeed = slot.NormalSpeed
    SpeedBooster.StealSpeed  = slot.StealSpeed
    SpeedBooster.Mode        = string.upper(modeName)
    
end


