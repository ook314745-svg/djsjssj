local function hideGUI()
    if isAnimating then return end
    isAnimating = true
    TweenService:Create(uiScale,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {Scale = 0}
    ):Play()
    task.wait(0.3)
    main.Visible = false
    guiVisible   = false
    isAnimating  = false
end

local function showGUI()
    if isAnimating then return end
    isAnimating  = true
    main.Visible = true
    uiScale.Scale = 0
    TweenService:Create(uiScale,
        TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Scale = calculateResponsiveScale()}
    ):Play()
    guiVisible  = true
    isAnimating = false
    task.wait(0.1)
    clampMainFrame()
end
