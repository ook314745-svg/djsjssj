local PAUSE_AT   = 1.0
local CLOSE_DIST = 10

local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function isInCarryState()
    local char = player.Character
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    local a = h:FindFirstChildOfClass("Animator")
    if not a then return false end
    for _, t in pairs(a:GetPlayingAnimationTracks()) do
        if t.Animation and string.find(t.Animation.AnimationId, CARRY_ANIM_ID) then
            return true
        end
    end
    return false
end

local function isMyBase(plotName)
    local plot = workspace.Plots:FindFirstChild(plotName)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local yourBase = sign:FindFirstChild("YourBase")
        if yourBase and yourBase:IsA("BillboardGui") then
            return yourBase.Enabled == true
        end
    end
    return false
end

local function scanSinglePlot(plot)
    if not plot or not plot:IsA("Model") then return end
    if isMyBase(plot.Name) then return end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return end
    for _, podium in ipairs(podiums:GetChildren()) do
        if podium:IsA("Model") then
            local base   = podium:FindFirstChild("Base")
            local spawn  = base and base:FindFirstChild("Spawn")
            local attach = spawn and spawn:FindFirstChild("PromptAttachment")
            if attach then
                local hasAnimal = false
                for _, p in ipairs(attach:GetChildren()) do
                    if p:IsA("ProximityPrompt") and p.Enabled then
                        hasAnimal = true
                        break
                    end
                end
                if hasAnimal then
                    table.insert(allAnimalsCache, {
                        plot          = plot.Name,
                        slot          = podium.Name,
                        worldPosition = podium:GetPivot().Position,
                        uid           = plot.Name .. "_" .. podium.Name,
                    })
                end
            end
        end
    end
end

local function initializeScanner()
    task.wait(2)
    local plots = workspace:WaitForChild("Plots", 10)
    if not plots then return end
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then scanSinglePlot(plot) end
    end
    task.spawn(function()
        while task.wait(5) do
            allAnimalsCache = {}
            for _, plot in ipairs(plots:GetChildren()) do
                if plot:IsA("Model") then scanSinglePlot(plot) end
            end
        end
    end)
end

local function findProximityPromptForAnimal(animalData)
    if not animalData then return nil end
    local cachedPrompt = PromptMemoryCache[animalData.uid]
    if cachedPrompt and cachedPrompt.Parent then return cachedPrompt end
    local plot    = workspace.Plots:FindFirstChild(animalData.plot)   if not plot    then return nil end
    local podiums = plot:FindFirstChild("AnimalPodiums")               if not podiums then return nil end
    local podium  = podiums:FindFirstChild(animalData.slot)            if not podium  then return nil end
    local base    = podium:FindFirstChild("Base")                      if not base    then return nil end
    local spawn   = base:FindFirstChild("Spawn")                       if not spawn   then return nil end
    local attach  = spawn:FindFirstChild("PromptAttachment")           if not attach  then return nil end
    for _, p in ipairs(attach:GetChildren()) do
        if p:IsA("ProximityPrompt") then
            PromptMemoryCache[animalData.uid] = p
            return p
        end
    end
    return nil
end

local function getNearestAnimal()
    local h = getHRP()
    if not h then return nil end
    local nearest, minDist = nil, math.huge
    for _, animalData in ipairs(allAnimalsCache) do
        if animalData.worldPosition then
            local dist = (h.Position - animalData.worldPosition).Magnitude
            if dist < minDist and dist <= InstaSteal.Radius then
                minDist = dist
                nearest = animalData
            end
        end
    end
    return nearest
end

local function buildStealCallbacks(prompt)
    local existing = InternalStealCache[prompt]
    if existing and (existing.ready or not existing.stale) then return end
    local data = { holdCallbacks = {}, triggerCallbacks = {}, ready = true, stale = false }
    local ok1, conns1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if ok1 and type(conns1) == "table" then
        for _, conn in ipairs(conns1) do
            if type(conn.Function) == "function" then
                table.insert(data.holdCallbacks, conn.Function)
            end
        end
    end
    local ok2, conns2 = pcall(getconnections, prompt.Triggered)
    if ok2 and type(conns2) == "table" then
        for _, conn in ipairs(conns2) do
            if type(conn.Function) == "function" then
                table.insert(data.triggerCallbacks, conn.Function)
            end
        end
    end
    if (#data.holdCallbacks > 0) or (#data.triggerCallbacks > 0) then
        InternalStealCache[prompt] = data
    end
end

local CRAWL_SPEED = 0.01

local function abortSteal(data, uid)
    if ProgressBarFill then
        ProgressBarFill.Size = UDim2.new(0, 0, 1, 0)
    end
    data.ready = true
    data.stale = true
    IsStealing = false
    if uid then
        lastAttemptTime[uid] = tick()
        InternalStealCache[PromptMemoryCache[uid]] = nil
        PromptMemoryCache[uid] = nil
    end
end

local function shouldAbort(capturedGen)
    return capturedGen ~= stealGeneration or isInCarryState()
end

local function executeInternalStealAsync(prompt, animalData, capturedGen)
    local data = InternalStealCache[prompt]
    if not data or not data.ready then return false end
    data.ready = false
    data.stale = false
    IsStealing = true
    task.spawn(function()
        if shouldAbort(capturedGen) then
            abortSteal(data, animalData and animalData.uid)
            return
        end
        if #data.holdCallbacks > 0 then
            for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
        end
        local duration   = 1.3
        local completed  = false
        local outOfRange = false
        while not completed and not outOfRange do
            if shouldAbort(capturedGen) then
                outOfRange = true
                break
            end
            local startTime = tick()
            while tick() - startTime < PAUSE_AT do
                if shouldAbort(capturedGen) then
                    outOfRange = true
                    break
                end
                local h = getHRP()
                if not h or not animalData or (h.Position - animalData.worldPosition).Magnitude > InstaSteal.Radius then
                    outOfRange = true
                    break
                end
                local progress = (tick() - startTime) / duration
                if ProgressBarFill then
                    TweenService:Create(ProgressBarFill,
                        TweenInfo.new(0.05),
                        {Size = UDim2.new(progress, 0, 1, 0)}
                    ):Play()
                end
                task.wait(0.05)
            end
            if outOfRange then break end
            local crawlProgress = PAUSE_AT / duration
            local playerArrived = false
            while not playerArrived do
                if shouldAbort(capturedGen) then
                    outOfRange = true
                    break
                end
                local h = getHRP()
                if not h or not animalData then
                    completed = true
                    break
                end
                local dist = (h.Position - animalData.worldPosition).Magnitude
                if dist > InstaSteal.Radius then
                    outOfRange = true
                    break
                end
                if dist <= CLOSE_DIST then
                    playerArrived = true
                else
                    crawlProgress = math.min(crawlProgress + CRAWL_SPEED * 0.05, 0.99)
                    if ProgressBarFill then
                        TweenService:Create(ProgressBarFill,
                            TweenInfo.new(0.05),
                            {Size = UDim2.new(crawlProgress, 0, 1, 0)}
                        ):Play()
                    end
                    task.wait(0.05)
                end
            end
            if outOfRange or completed then break end
            local resumeStart      = tick()
            local progressAtResume = crawlProgress
            local remaining        = (1 - crawlProgress) * duration
            local fled             = false
            while tick() - resumeStart < remaining do
                if shouldAbort(capturedGen) then
                    outOfRange = true
                    break
                end
                local h2 = getHRP()
                if h2 then
                    local dist2 = (h2.Position - animalData.worldPosition).Magnitude
                    if dist2 > InstaSteal.Radius then
                        outOfRange = true
                        break
                    end
                    if dist2 > CLOSE_DIST then
                        fled = true
                        break
                    end
                end
                local progress = progressAtResume + (tick() - resumeStart) / duration
                if ProgressBarFill then
                    TweenService:Create(ProgressBarFill,
                        TweenInfo.new(0.05),
                        {Size = UDim2.new(math.min(progress, 1), 0, 1, 0)}
                    ):Play()
                end
                task.wait(0.05)
            end
            if outOfRange then break end
            if fled then
                if ProgressBarFill then
                    ProgressBarFill.Size = UDim2.new(0, 0, 1, 0)
                end
            else
                completed = true
            end
        end
        if outOfRange then
            abortSteal(data, animalData and animalData.uid)
            return
        end
        if #data.triggerCallbacks > 0 then
            for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
        end
        task.wait(0.01)
        data.ready = true
        task.wait(0.01)
        if ProgressBarFill then
            ProgressBarFill.Size = UDim2.new(0, 0, 1, 0)
        end
        IsStealing = false
        if animalData then
            lastAttemptTime[animalData.uid] = tick()
        end
    end)
    return true
end

local STEAL_COOLDOWN = 0.1

local function attemptSteal(prompt, animalData)
    if not prompt or not prompt.Parent then return false end
    if animalData and lastAttemptTime[animalData.uid] then
        if tick() - lastAttemptTime[animalData.uid] < STEAL_COOLDOWN then return false end
    end
    buildStealCallbacks(prompt)
    if not InternalStealCache[prompt] then return false end
    return executeInternalStealAsync(prompt, animalData, stealGeneration)
end

local function startStealLoop()
    if InstaSteal.Connection then InstaSteal.Connection:Disconnect() end
    InstaSteal.Connection = RunService.Heartbeat:Connect(function()
        if IsStealing then return end
        if isInCarryState() then return end
        local targetAnimal = getNearestAnimal()
        if not targetAnimal then return end
        local prompt = PromptMemoryCache[targetAnimal.uid]
        if not prompt or not prompt.Parent then
            prompt = findProximityPromptForAnimal(targetAnimal)
        end
        if prompt then attemptSteal(prompt, targetAnimal) end
    end)
end

