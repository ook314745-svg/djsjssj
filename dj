-- Sound
task.spawn(function()
    pcall(function()
        local folder = "FS_Sounds"
        local fileName = "soundr.mp3"
        local soundPath = folder .. "/" .. fileName

        local assetFunc = getsynasset or getcustomasset

        if not assetFunc then
            warn("Executor does not support custom assets.")
            return
        end

        if not isfolder(folder) then
            makefolder(folder)
        end

        if not isfile(soundPath) then
            writefile(
                soundPath,
                game:HttpGet("https://files.catbox.moe/npx5e7")
            )
        end

        local sound = Instance.new("Sound")
        sound.SoundId = assetFunc(soundPath)
        sound.Volume = 5
        sound.Parent = game:GetService("SoundService")

        sound:Play()
        task.wait(13)
        sound:Stop()
        sound:Destroy()
    end)
end)

-- FR HUB INTRO
task.spawn(function()
    pcall(function()
        local TweenService = game:GetService("TweenService")
        local Players = game:GetService("Players")
        local CoreGui = game:GetService("CoreGui")

        local player = Players.LocalPlayer

        for exec = 1, 10 do
            task.spawn(function()
                local gui = Instance.new("ScreenGui")
                gui.Name = "FRHUBINTRO_" .. exec
                gui.ResetOnSpawn = false
                gui.Parent = CoreGui

                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                bg.BackgroundTransparency = 1
                bg.BorderSizePixel = 0
                bg.Parent = gui

                for i = 1, 20 do
                    local line = Instance.new("Frame")
                    line.Size = UDim2.new(0, math.random(100, 300), 0, 2)
                    line.Position = UDim2.new(math.random(), 0, math.random(), 0)
                    line.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                    line.BorderSizePixel = 0
                    line.BackgroundTransparency = 0.3
                    line.Parent = bg

                    local tween = TweenService:Create(
                        line,
                        TweenInfo.new(
                            math.random(1, 3),
                            Enum.EasingStyle.Linear,
                            Enum.EasingDirection.Out,
                            -1
                        ),
                        {
                            Position = UDim2.new(-1, 0, line.Position.Y.Scale, 0)
                        }
                    )
                    tween:Play()
                end

                local title = Instance.new("TextLabel")
                title.Size = UDim2.new(1, 0, 0.2, 0)
                title.Position = UDim2.new(0, 0, 0.4, 0)
                title.BackgroundTransparency = 1
                title.Text = "FR HUB"
                title.Font = Enum.Font.Arcade
                title.TextScaled = true
                title.TextColor3 = Color3.fromRGB(138, 43, 226)
                title.TextStrokeTransparency = 0
                title.TextTransparency = 1
                title.Parent = bg

                local function animateLettersFast()
                    title.TextTransparency = 0
                    local text = "FR HUB"
                    title.Text = ""

                    for i = 1, #text do
                        title.Text = string.sub(text, 1, i)
                        task.wait(0.06)
                    end
                end

                animateLettersFast()

                task.spawn(function()
                    while title.Parent do
                        title.Position = UDim2.new(0, math.random(-3, 3), 0.4, math.random(-2, 2))
                        task.wait(0.03)
                    end
                end)

                task.wait(12)

                TweenService:Create(
                    title,
                    TweenInfo.new(0.5),
                    {
                        TextTransparency = 1
                    }
                ):Play()

                task.wait(0.6)
                gui:Destroy()
            end)

            task.wait(0.1)
        end
    end)
end)


